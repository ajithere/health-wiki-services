# .env — copy this to your project root and fill in your values
# Never commit this file to git

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Set LLM_PROVIDER to one of:
#   anthropic | openai | google | ollama | openai-compatible

LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# Anthropic
ANTHROPIC_API_KEY=your-key-here

# OpenAI (also used for openai-compatible providers like Groq, Together)
# OPENAI_API_KEY=your-key-here
# OPENAI_BASE_URL=                  # leave blank for OpenAI; set for compatible APIs
                                    # e.g. https://api.groq.com/openai/v1

# Google Gemini
# GOOGLE_API_KEY=your-key-here

# Ollama (local, no key needed)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3
# OLLAMA_BASE_URL=http://localhost:11434

# ── Paths ─────────────────────────────────────────────────────────────────────
BASE_DIR=/path/to/your/project

# ── Staging ───────────────────────────────────────────────────────────────────
STAGING_ENABLED=true
STAGING_AUTO_APPROVE=false

# ── LLM tuning ───────────────────────────────────────────────────────────────
LLM_MAX_TOKENS=8000
LLM_TEMPERATURE=0
